# Configuração do Spring
SPRING_PROFILES_ACTIVE=ACTIVE-PROFILE

# Configuração do root user inicial
ROOT_USERNAME=ROOT-USERNAME
ROOT_PASSWORD=ROOT-PASSWORD

# Configuração do Spring Security
JWT_TOKEN_SECRET_KEY=SECRET-KEY
JWT_TOKEN_EXPIRE_LENGTH=TOKEN-EXPIRE-LENGTH

# Configuração do Banco de Dados de Produção
DB_USERNAME=DB-USERNAME
DB_PASSWORD=DB-PASSWORD
DB_URL=DB-URL

# Configuração do Banco de Dados de Desenvolvimento
DEV_DB_USERNAME=DEV-DB-USERNAME
DEV_DB_PASSWORD=DEV-DB-PASSWORD
DEV_DB_URL=DEV-DB-URL
